{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomseai/my-repo-radar/schema/search-index.schema.json",
  "title": "Generated repository search index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_schema_version", "count", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_schema_version": { "const": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "owner", "url", "category", "topics", "kind",
          "languages", "technologies", "license", "lifecycle", "archived",
          "confidence", "stars", "text"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^github:[^/]+/[^/]+$" },
          "name": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "category": { "type": ["string", "null"] },
          "topics": { "$ref": "#/$defs/strings" },
          "kind": { "type": ["string", "null"] },
          "languages": { "$ref": "#/$defs/strings" },
          "technologies": { "$ref": "#/$defs/strings" },
          "license": { "type": ["string", "null"] },
          "lifecycle": { "type": ["string", "null"] },
          "archived": { "type": ["boolean", "null"] },
          "confidence": { "type": ["string", "null"] },
          "stars": { "type": "integer", "minimum": 0 },
          "text": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
