{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomseai/my-repo-radar/schema/catalog.schema.json",
  "title": "Generated repository catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_versions", "counts", "repositories"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dossier", "inventory", "taxonomy"],
      "properties": {
        "dossier": { "type": "integer", "minimum": 1 },
        "inventory": { "type": "integer", "minimum": 1 },
        "taxonomy": { "type": "integer", "minimum": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "research_states", "confidence"],
      "properties": {
        "repositories": { "type": "integer", "minimum": 0 },
        "research_states": { "$ref": "#/$defs/counts" },
        "confidence": { "$ref": "#/$defs/counts" }
      }
    },
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "strings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "identity", "project", "classification", "key_features", "usage",
        "technology", "license", "status", "github", "research", "strengths",
        "caveats", "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^github:[^/]+/[^/]+$" },
        "identity": { "$ref": "#/$defs/identity" },
        "project": { "$ref": "#/$defs/project" },
        "classification": { "$ref": "#/$defs/classification" },
        "key_features": { "$ref": "#/$defs/strings" },
        "usage": { "$ref": "#/$defs/usage" },
        "technology": { "$ref": "#/$defs/technology" },
        "license": { "$ref": "#/$defs/license" },
        "status": { "$ref": "#/$defs/status" },
        "github": { "$ref": "#/$defs/github" },
        "research": { "$ref": "#/$defs/research" },
        "strengths": { "$ref": "#/$defs/strings" },
        "caveats": { "$ref": "#/$defs/strings" },
        "sources": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aliases", "name", "owner", "url"],
      "properties": {
        "aliases": { "$ref": "#/$defs/strings" },
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["best_for", "kind", "name", "summary"],
      "properties": {
        "best_for": { "$ref": "#/$defs/strings" },
        "kind": { "$ref": "#/$defs/nullableString" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/nullableString" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_category", "technologies", "topics", "use_cases"],
      "properties": {
        "primary_category": { "$ref": "#/$defs/nullableString" },
        "technologies": { "$ref": "#/$defs/strings" },
        "topics": { "$ref": "#/$defs/strings" },
        "use_cases": { "$ref": "#/$defs/strings" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation", "interfaces", "setup"],
      "properties": {
        "installation": { "$ref": "#/$defs/strings" },
        "interfaces": { "$ref": "#/$defs/strings" },
        "setup": { "$ref": "#/$defs/nullableString" }
      }
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "notable_components"],
      "properties": {
        "languages": { "$ref": "#/$defs/strings" },
        "notable_components": { "$ref": "#/$defs/strings" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "notes", "spdx"],
      "properties": {
        "name": { "$ref": "#/$defs/nullableString" },
        "notes": { "$ref": "#/$defs/nullableString" },
        "spdx": { "$ref": "#/$defs/nullableString" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archived", "latest_release", "latest_release_at", "lifecycle"],
      "properties": {
        "archived": { "type": ["boolean", "null"] },
        "latest_release": { "$ref": "#/$defs/nullableString" },
        "latest_release_at": { "$ref": "#/$defs/nullableString" },
        "lifecycle": { "$ref": "#/$defs/nullableString" }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archived", "created_at", "default_branch", "description", "disabled", "fetched_at", "fork",
        "forks", "homepage", "license_spdx", "latest_release", "open_issues", "primary_language",
        "pushed_at", "stars", "topics", "updated_at"
      ],
      "properties": {
        "archived": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/nullableString" },
        "default_branch": { "$ref": "#/$defs/nullableString" },
        "description": { "$ref": "#/$defs/nullableString" },
        "disabled": { "type": "boolean" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "fork": { "type": "boolean" },
        "forks": { "type": "integer", "minimum": 0 },
        "homepage": { "$ref": "#/$defs/nullableString" },
        "license_spdx": { "$ref": "#/$defs/nullableString" },
        "latest_release": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["published_at", "tag", "url"],
              "properties": {
                "published_at": { "$ref": "#/$defs/nullableString" },
                "tag": { "type": "string" },
                "url": { "$ref": "#/$defs/nullableString" }
              }
            }
          ]
        },
        "open_issues": { "type": "integer", "minimum": 0 },
        "primary_language": { "$ref": "#/$defs/nullableString" },
        "pushed_at": { "$ref": "#/$defs/nullableString" },
        "stars": { "type": "integer", "minimum": 0 },
        "topics": { "$ref": "#/$defs/strings" },
        "updated_at": { "$ref": "#/$defs/nullableString" }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_collected_at", "confidence", "researched_at", "source_commit", "state"],
      "properties": {
        "bundle_collected_at": { "type": "string", "format": "date-time" },
        "confidence": { "$ref": "#/$defs/nullableString" },
        "researched_at": { "$ref": "#/$defs/nullableString" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "state": { "type": "string", "minLength": 1 }
      }
    }
  }
}
