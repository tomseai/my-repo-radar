{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomseai/my-repo-radar/schema/taxonomy.schema.json",
  "title": "Catalog taxonomy",
  "description": "Controlled vocabulary used by repository analysis records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "primary_categories", "topics", "use_cases", "technologies"],
  "properties": {
    "version": { "const": 1 },
    "primary_categories": { "$ref": "#/$defs/vocabulary" },
    "topics": { "$ref": "#/$defs/vocabulary" },
    "use_cases": { "$ref": "#/$defs/vocabulary" },
    "technologies": { "$ref": "#/$defs/vocabulary" }
  },
  "$defs": {
    "vocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
